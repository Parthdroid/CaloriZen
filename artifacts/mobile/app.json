{
  "expo": {
    "name": "CaloriZen",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calorizen",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.parth.calorizen",
      "infoPlist": {
        "CFBundleDisplayName": "CaloriZen",
        "NSCameraUsageDescription": "CaloriZen needs camera access to take photos of your meals for AI nutrition analysis.",
        "NSPhotoLibraryUsageDescription": "CaloriZen needs photo library access to pick meal photos for nutrition analysis."
      }
    },
    "android": {
      "package": "ai.calorizen.app",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "CaloriZen needs access to your photos to analyze meals.",
          "cameraPermission": "CaloriZen needs camera access to take photos of your meals.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
